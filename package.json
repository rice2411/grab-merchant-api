{
  "name": "grab-merchant-api",
  "version": "0.4.0",
  "description": "Unofficial Grab Merchant API for Node.js — log in to the GrabFood merchant portal, read live and past orders, manage menu availability and inventory using session cookies.",
  "license": "MIT",
  "author": "rice2411",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rice2411/grab-merchant-api.git"
  },
  "homepage": "https://github.com/rice2411/grab-merchant-api#readme",
  "bugs": {
    "url": "https://github.com/rice2411/grab-merchant-api/issues"
  },
  "keywords": [
    "grab",
    "grabfood",
    "grab-merchant",
    "merchant",
    "orders",
    "menu",
    "inventory",
    "unofficial",
    "api"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.11",
    "eslint": "^10.14.0",
    "prettier": "^3.10.0",
    "tsup": "^9.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
